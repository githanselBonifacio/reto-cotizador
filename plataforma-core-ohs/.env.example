# MongoDB Configuration
MONGODB_URL=mongodb://localhost:27017
DATABASE_NAME=CATALOGO_DANOS

# Security Configuration
# In non-debug environments, SECRET_KEY must be at least 32 characters.
# In non-debug environments, API_KEY must be at least 24 characters.
SECRET_KEY=change-this-secret-key-with-at-least-32-characters
API_KEY=change-this-api-key-with-at-least-24-characters
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Application Configuration
APP_NAME=Plataforma Core OHS
APP_VERSION=1.0.0
DEBUG=True
EXPOSE_DOCS=True
MAX_PAGE_SIZE=100

# HTTP Security Configuration
# Use comma-separated values, for example:
# CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ORIGINS=*
ALLOWED_HOSTS=*

# Docker local development only
MONGO_ROOT_USERNAME=ohs_admin
MONGO_ROOT_PASSWORD=change-this-local-password

